# Copy to .env.local. Everything is optional: with nothing set, Pepper runs in LOCAL MODE
# (JSON database + files in ./.data + demo login) so you can try it immediately.

# ---- Firebase Auth (browser) — Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server: verifies logins + Firestore database)
# Project settings → Service accounts → Generate new private key, then paste the output of
#   base64 -i path/to/key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# …or give the same key as three values instead:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Emails allowed into the admin panel (comma separated)
ADMIN_EMAILS=you@example.com
# Invite-only listening (optional): only these emails (and admins) can use Pepper once signed in.
# Use "@example.com" for everyone at a domain. Leave empty to let anyone who signs in listen.
LISTENER_EMAILS=

# Vercel daily maintenance job: generate a random secret and set it in deployment environment.
CRON_SECRET=

# ---- Cloudflare R2 (S3 API) — R2 → Manage API tokens (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pepper-music
R2_QUOTA_GB=10

# ---- Backblaze B2 (S3 API) — App Keys → Add a New Application Key
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=pepper-music
B2_QUOTA_GB=10

# More Backblaze accounts: the same settings with B2_2_, B2_3_, … in front (any number).
# Uploads then spread across all buckets by free space (see STORAGE_STRATEGY). Songs remember
# which account they are in, so never renumber an account that holds songs. To stop new uploads
# to one without losing its songs, set its quota to 0.
# B2_2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# B2_2_KEY_ID=
# B2_2_APPLICATION_KEY=
# B2_2_BUCKET=
# B2_2_QUOTA_GB=10
# Optional name shown on the admin dashboard:
# B2_2_LABEL=Second Backblaze account

# Where new uploads go:
#   fill-first: one bucket at a time (R2 first, for its free egress, then B2 accounts in order)
#   balance:    the bucket with the most free space, so all buckets fill up together
STORAGE_STRATEGY=fill-first

# Free metadata enrichment (LRCLIB lyrics, Deezer artist photos)
ENRICH_LYRICS=true
ENRICH_ARTIST_IMAGES=true
# Genre from Apple's catalog + related artists from Deezer, used by autoplay
ENRICH_GENRES=true

# ---- Optional: develop against the Firebase Emulator Suite instead of production
# (firebase emulators:start --only auth,firestore --project demo-pepper; Firestore needs Java 21).
# No real credentials needed: leave the Firebase values above empty and set these instead.
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pepper
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-pepper
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Force a database backend: local | firestore (default: auto-detect)
# PEPPER_DB=local
